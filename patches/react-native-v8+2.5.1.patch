+// Used to ignore -Wunused-variable.
+template <typename>
+struct EatParams {};
+
+#if defined(DEBUG)
+#define CPPGC_DCHECK_MSG(condition, message)  \
+  do {                                        \
+    if (V8_UNLIKELY(!(condition))) {          \
